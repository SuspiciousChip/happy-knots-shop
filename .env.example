MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=happy_knots
# Only needed on macOS when Node's Atlas SRV lookup reports EBADRESP.
MONGODB_DNS_FALLBACK=dig
FLASK_SECRET_KEY=replace-with-a-long-random-secret
# Provision with database/setup-customer-auth.js once in the selected AWS Region.
COGNITO_POOL_ID=ap-southeast-2_example
COGNITO_ISSUER=https://cognito-idp.ap-southeast-2.amazonaws.com/ap-southeast-2_example
COGNITO_CLIENT_ID=example
COGNITO_CLIENT_SECRET=replace-with-confidential-client-secret
COGNITO_DOMAIN=https://example.auth.ap-southeast-2.amazoncognito.com
APP_BASE_URL=http://localhost:5050
RECAPTCHA_SITE_KEY=your-public-v2-checkbox-site-key
RECAPTCHA_SECRET_KEY=your-private-v2-checkbox-secret-key
# Optional Razorpay test-mode credentials. Keep the secret on the server only.
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-with-test-key-secret
# Enables the simulated checkout only on a local, non-production server.
RAZORPAY_TEST_CHECKOUT=false
PORT=5050
# Render sets RENDER=true and PORT automatically. Set APP_BASE_URL=https://www.happyknots.shop there.
# Do not set MONGODB_DNS_FALLBACK=dig on Render; it is a local macOS workaround.
