MONGODB_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB=happy_knots
# Only needed on macOS when Node's Atlas SRV lookup reports EBADRESP.
MONGODB_DNS_FALLBACK=dig
FLASK_SECRET_KEY=replace-with-a-long-random-secret
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD_HASH=existing-Werkzeug-scrypt-hash
PORT=5050
